//https://leetcode.com/problems/isomorphic-strings/description/
class Solution {
public:
    bool isIsomorphic(string s, string t) {
        int n=s.size();
        int m=t.size();
        if(n!=m)
        return false;

        unordered_map<char,char>stMap;
        unordered_map<char,char>tsMap;
        for(int i=0;i<n;i++)
        {
            char c1=s[i];
            char c2=t[i];

            if(stMap.count(c1))
            {
                if(stMap[c1]!=c2)
                {
                    return false;
                }
            }
            else
            {
                stMap[c1]=c2;
            }
             if(tsMap.count(c2))
            {
                if(tsMap[c2]!=c1)
                {
                    return false;
                }
            }
            else
            {
                tsMap[c2]=c1;
            }
        }
        return true;
    }
};
