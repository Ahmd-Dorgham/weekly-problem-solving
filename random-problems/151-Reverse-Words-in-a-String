//https://leetcode.com/problems/reverse-words-in-a-string/description/
class Solution {
public:
    string reverseWords(string s) {
       
       int n=s.size();
       string result="";
       
       for(int i=n-1;i>=0;i--)
       {
           
           while(i >= 0 && s[i]==' ')
           {
               i--;
           }
           if(i<0)
            break;
           int c = 0;
           
           while(i >= 0 && s[i] != ' ')
           {
               c++;
               i--;
           }
           result += s.substr(i+1,c) + ' ';
       }
         if (!result.empty()) {
        result.pop_back();
    }

    return result;
    }
};
