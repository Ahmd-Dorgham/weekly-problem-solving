class Solution {
public:
    string removeOuterParentheses(string s)
{
    if(s=="")
        return "";

    int n=s.size();
    string result="";
    int left=0;
    int right=0;
    int start=0;

    for(int i=0; i<n; i++)
    {
        if(s[i]=='(')
        {
            left++;
        }
        else
        {
            right++;
        }
        if(right==left)
        {
            result +=s.substr(start+1,i-start-1);
            left=0;
            right=0;
            start=i+1;
        }

    }
    return result;
}
};
