//https://leetcode.com/problems/apple-redistribution-into-boxes/description/?envType=daily-question&envId=2025-12-24
class Solution {
public:
   int minimumBoxes(vector<int>& apple, vector<int>& capacity)
{
    sort(capacity.begin(),capacity.end());
    int n=apple.size();
    int m=capacity.size();
    int sum=0;
    for(int i=0; i<n; i++)
    {
        sum+=apple[i];
    }
    int sum2=0;
    for(int i=m-1; i>=0; i--)
    {
        sum2+=capacity[i];
        if(sum2>=sum)
        {
            return m-i;
        }
    }
    return 0;
}
};
