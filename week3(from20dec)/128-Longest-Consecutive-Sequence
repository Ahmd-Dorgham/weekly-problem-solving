//https://leetcode.com/problems/longest-consecutive-sequence/description/
class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
       
       int n=nums.size();
       if (n==0) return 0;
       sort(nums.begin(),nums.end());
       int cnt=1; int maxLong=1;
       int ele=nums[0];
       
       for(int i=1;i<n;i++)
       {
           if(nums[i]-1==ele)
           {
               cnt++;
               ele=nums[i];
           }
           else if(nums[i]!=ele)
           {
               
               cnt=1;
               ele=nums[i];
           }
           maxLong=max(maxLong,cnt);
           
       }
       return maxLong;
    }
};
