class Solution {
    // Function to find the leaders in the array.
  public:
   vector<int> leaders(vector<int>& nums) {
      
      vector<int>v;
      int n=nums.size();
      int x=nums[n-1];
      v.push_back(nums[n-1]);
      
      for(int i=n-2;i>=0;i--)
      {
          if(nums[i]>=x)
          {
              x=nums[i];
              v.push_back(nums[i]);
          }
          
      }
      reverse(v.begin(),v.end());
      return v;
      
    }
};
