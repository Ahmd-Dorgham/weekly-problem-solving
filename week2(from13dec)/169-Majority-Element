//https://leetcode.com/problems/majority-element/description/
class Solution {
public:
    int majorityElement(vector<int>& nums) {

    unordered_map<int,int>mp;
    int n=nums.size();
    for(int i=0;i<n;i++)
    {
            mp[nums[i]]++;
            if(mp[nums[i]]>n/2)
            {
                return nums[i];
            }
    }

    return 0;
    }
};
//Boyer–Moore Majority Vote
int majorityElement(vector<int>& nums)
{

    int n=nums.size();
    int el=nums[0];
    int countt=1;

    for(int i=1; i<n; i++)
    {
        if(nums[i]==el)
        {
            countt++;
        }
        else if(countt==0)
        {
            el=nums[i];
            countt=1;
        }
        else
        {
            countt--;
        }

    }

    int freq=0;

    for(int i=0; i<n; i++)
    {
        if(nums[i]==el)
        {
            freq++;
        }
    }
    if(freq>n/2)
    {
        return el;
    }
    else
        return -1;


}
