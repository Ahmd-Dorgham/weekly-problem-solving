//https://leetcode.com/problems/majority-element/description/
class Solution {
public:
    int majorityElement(vector<int>& nums) {

    unordered_map<int,int>mp;
    int n=nums.size();
    for(int i=0;i<n;i++)
    {
            mp[nums[i]]++;
            if(mp[nums[i]]>n/2)
            {
                return nums[i];
            }
    }

    return 0;
    }
};
//Boyer–Moore Majority Vote
int majorityElement(vector<int>& nums) {

    int n=nums.size();
    int el=nums[0];
    int countt=1;

    for(int i=1;i<n;i++)
    {
        if(nums[i]==el)
        {
            countt++;
        }
        else
        {
            countt--;
            if(countt==-1)
            {
                el=nums[i];
                countt=1;
            }
        }
    }
    return el;

    }
