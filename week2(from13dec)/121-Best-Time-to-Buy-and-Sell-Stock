//https://leetcode.com/problems/best-time-to-buy-and-sell-stock/description/
class Solution {
public:
     int maxProfit(vector<int>& prices) {
        int buy=INT_MAX;
        int maxP=0;
        int n=prices.size();
        for(int i=0;i<n;i++)
        {
            if(prices[i]<buy)
            {
                buy=prices[i];
            }
            else
            {

                maxP=max(maxP,prices[i]-buy);
            }
            
        }
        return maxP;
    }
};
