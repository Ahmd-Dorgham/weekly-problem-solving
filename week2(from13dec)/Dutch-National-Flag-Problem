//https://www.geeksforgeeks.org/problems/sort-an-array-of-0s-1s-and-2s4231/1
class Solution {
  public:
    void sort012(vector<int>& arr) {
        // code here
         int n=arr.size();
    int low=0,mid=0,high=n-1;

    for(int i=0; i<n; i++)
    {
        if(arr[mid]==0)
        {
            swap(arr[mid],arr[low]);
            low++;
            mid++;
        }
        else if(arr[mid]==1)
        {
            mid++;
        }
        else
        {
            swap(arr[mid],arr[high]);
            high--;
        }

    }

    }
};
